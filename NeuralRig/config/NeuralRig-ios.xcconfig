
// IPLUG2_ROOT should point to the top level IPLUG2 folder
// By default, that is three directories up from /Examples/NeuralRig/config
// If you want to build your project "out of source", you can change IPLUG2_ROOT and the path to common-ios.xcconfig

IPLUG2_ROOT = ../../iPlug2

#include "../../common-ios.xcconfig"

//------------------------------
// Global build settings

// the basename of the vst, vst3, app, component, aaxplugin
BINARY_NAME = NeuralRig

// ------------------------------
// HEADER AND LIBRARY SEARCH PATHS
EXTRA_INC_PATHS =  $(IPLUG2_ROOT)/../eigen $(IGRAPHICS_INC_PATHS)
EXTRA_LIB_PATHS = $(IGRAPHICS_LIB_PATHS)
// AuthenticationServices provides ASWebAuthenticationSession, used by
// IOSAuth.mm to present TONE3000 sign-in. Note that everything after the "//"
// on this line is a comment, so new frameworks belong before it.
EXTRA_LNK_FLAGS = -framework Metal -framework MetalKit -framework Accelerate -framework AuthenticationServices//$(IGRAPHICS_LNK_FLAGS)

//------------------------------
// PREPROCESSOR MACROS

EXTRA_ALL_DEFS = OBJC_PREFIX=vNeuralRig IGRAPHICS_NANOVG IGRAPHICS_METAL GRAYED_ALPHA=0.5f
//EXTRA_DEBUG_DEFS =
//EXTRA_RELEASE_DEFS =
//EXTRA_TRACER_DEFS =

//------------------------------
// RELEASE BUILD OPTIONS

//Enable/Disable Profiling code
PROFILE = NO //NO, YES - enable this if you want to use instruments to profile a plugin

// GCC optimization level -
// None: [-O0] Fast: [-O, -O1] Faster:[-O2] Fastest: [-O3] Fastest, smallest: Optimize for size. [-Os]
RELEASE_OPTIMIZE = 3 //0,1,2,3,s

//------------------------------
// DEBUG BUILD OPTIONS
DEBUG_OPTIMIZE = 0 //0,1,2,3,s

//------------------------------
// MISCELLANEOUS COMPILER OPTIONS

GCC_INCREASE_PRECOMPILED_HEADER_SHARING = NO

// Uncomment to enable relaxed IEEE compliance
//GCC_FAST_MATH = YES

// Flags to pass to compiler for all builds
GCC_CFLAGS = -Wno-write-strings

// Bitcode was deprecated in Xcode 13 and removed in Xcode 14; leaving it on
// makes the build fail outright on any current toolchain. The iPlug2 template
// still ships YES because it predates that change.
ENABLE_BITCODE = NO
