# Build output.
#
# These are anchored deliberately. An unanchored "x64/" matches at any depth,
# and it silently swallowed the WebView2 SDK's own x64 directory -- the arm64
# and x86 import libraries were committed while the one architecture we build
# for was not, so CI failed to link something that was present locally.
/NeuralRig/build-win/
/NeuralRig/build-mac/
/NeuralRig/build-ios/
/NeuralRig/build-web/
/build-win/
/build-mac/
/out/

# Visual Studio
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.ncb
*.aps
ipch/
*.VC.db
*.VC.opendb

# Xcode
DerivedData/
*.xcuserdatad/
xcuserdata/
*.xcworkspace/xcuserdata/

# iPlug2 fetches these into the submodule; they are not ours to track
iPlug2/Dependencies/Build/
iPlug2/Dependencies/IPlug/VST3_SDK/
iPlug2/Dependencies/IPlug/VST2_SDK/
iPlug2/Dependencies/IPlug/AAX_SDK/
iPlug2/Dependencies/IPlug/WAM_SDK/
iPlug2/Dependencies/IPlug/WAM_AWP/
iPlug2/Dependencies/IPlug/RTAudio/
iPlug2/Dependencies/IPlug/RTMidi/
iPlug2/Dependencies/IPlug/REAPER_SDK/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local tooling / assistant config (not part of the project)
CLAUDE.md
.claude/

# Local secrets - never commit
.env
.env.local
**/LocalConfig.h

# Downloaded model cache used during manual testing
/models-cache/
*.nam.download
build.log
